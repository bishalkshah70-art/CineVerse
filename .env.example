# TMDB API Read Access Token (Bearer). Never prefix with NEXT_PUBLIC_.
# Create an account at https://www.themoviedb.org/ then:
# Settings → API → Request an API Key → copy the "API Read Access Token".
TMDB_READ_TOKEN=your_tmdb_read_token_here

# Default ISO 3166-1 region used for watch-provider availability and regional popularity.
# Users can override this in the header. Examples: US, GB, NP, IN, JP, BR.
TMDB_DEFAULT_REGION=US

# Optional ISO 639 language for metadata descriptions. Examples: en-US, ne-NP, hi-IN.
TMDB_METADATA_LANGUAGE=en-US
